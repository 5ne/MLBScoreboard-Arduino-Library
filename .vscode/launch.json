{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug live_run (cpptools / lldb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/test/build/live_run",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "MLB_TEAM",
                    "value": "SF"
                },
                {
                    "name": "MLB_TZ_OFFSET_MIN",
                    "value": "-420"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "Build live_run",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug live_run (CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/test/build/live_run",
            "args": [],
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "MLB_TEAM": "SF",
                "MLB_TZ_OFFSET_MIN": "-420"
            },
            "sourceMap": {},
            "preLaunchTask": "Build live_run"
        }
    ]
}
